{
    "name": "priyansh/it-company",
    "description": "A robust career application and mailing system for IT Company.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Priyansh",
            "email": "developer@example.com",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "phpmailer/phpmailer": "^6.8"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Dependencies installed successfully.'"
        ]
    }
}
