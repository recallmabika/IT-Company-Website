declare(strict_types=1);

use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\SMTP;
use PHPMailer\PHPMailer\Exception;

// Ensure dependencies are managed via Composer
require_once __DIR__ . '/vendor/autoload.php';

// It is highly recommended to move these to an .env file or a protected config array
require_once __DIR__ . '/mailingvariables.php';

/**
 * mailfunction
 *
 * An improved wrapper for PHPMailer that includes strict typing,
 * better error logging, and dynamic attachment handling.
 *
 * @param string $receiverEmail  Recipient's email address.
 * @param string $receiverName   Recipient's display name.
 * @param string $messageBody    The HTML content of the email.
 * @param string|null $filePath  Optional absolute path to an attachment.
 * @param string $subject        The email subject line.
 * @return bool                  True if sent successfully, false otherwise.
 */
function mailfunction(
    string $receiverEmail,
    string $receiverName,
    string $messageBody,
    ?string $filePath = null,
    string $subject = 'Someone Contacted You!'
): bool {
    
    // Initialize PHPMailer with Exception support enabled
    $mail = new PHPMailer(true);

    try {
        // --- Server Configuration ---
        // $mail->SMTPDebug = SMTP::DEBUG_SERVER; // Enable for troubleshooting
        $mail->isSMTP();
        $mail->Host       = (string)($GLOBALS['mail_host'] ?? '');
        $mail->SMTPAuth   = true;
        $mail->Username   = (string)($GLOBALS['mail_sender_email'] ?? '');
        $mail->Password   = (string)($GLOBALS['mail_sender_password'] ?? '');
        $mail->SMTPSecure = PHPMailer::ENCRYPTION_STARTTLS; 
        $mail->Port       = (int)($GLOBALS['mail_port'] ?? 587);
        $mail->CharSet    = PHPMailer::CHARSET_UTF8;

        // --- Sender & Recipient ---
        $mail->setFrom(
            (string)$GLOBALS['mail_sender_email'], 
            (string)$GLOBALS['mail_sender_name']
        );
        $mail->addAddress($receiverEmail, $receiverName);

        // --- Attachment Handling ---
        if ($filePath !== null && file_exists($filePath)) {
            $mail->addAttachment($filePath);
        }

        // --- Content Logic ---
        $mail->isHTML(true);
        $mail->Subject = $subject;
        
        // Use msgHTML to auto-generate plain-text and handle inline images
        $mail->msgHTML($messageBody);

        // Robust AltBody for non-HTML clients
        $mail->AltBody = strip_tags(str_replace(['<br>', '<br/>', '</p>'], "\n", $messageBody));

        // Final delivery
        return $mail->send();

    } catch (Exception $e) {
        // Log the error for the administrator
        error_log("PHPMailer System Error: " . $e->getMessage());
        return false;
    } catch (\Throwable $e) {
        // Catch any other unexpected PHP errors
        error_log("Critical Mailing Error: " . $e->getMessage());
        return false;
    }
}
